{
  "name": "solidity-ai-testing",
  "version": "0.1.0",
  "description": "Educational CLI: AI-assisted Foundry test generation and vulnerability detection for Solidity",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sat": "./dist/cli/index.js"
  },
  "scripts": {
    "sat": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "execa": "^10.2.1",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
